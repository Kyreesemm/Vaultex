{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultex",
  "version": "0.1.0",
  "identifier": "dev.vaultex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vaultex",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.svg"],
    "targets": "all",
    "shortDescription": "A private encrypted vault",
    "longDescription": "A cross-platform encrypted vault for private notes, accounts, and passwords."
  }
}
