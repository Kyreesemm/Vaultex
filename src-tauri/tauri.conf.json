{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultex",
  "version": "0.1.0",
  "identifier": "dev.vaultex.desktop",
  "build": {
    "beforeDevCommand": "python3 -m http.server 1420 --directory webui",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../webui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vaultex",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
